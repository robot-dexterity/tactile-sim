<?xml version="1.0" ?>
<robot name="hemisphere.urdf">

  <link name="hemisphere">
    <contact>
      <friction_anchor/>
      <lateral_friction value="1.0"/>
    </contact>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.01875"/>
      <mass value="0.1"/>
      <inertia ixx="0.00006484375" ixy="0" ixz="0" iyy="0.00006484375" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="hemisphere.obj" scale="1 1 1"/>
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="hemisphere.obj" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>

</robot>
